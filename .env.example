# Copy this file to .env and fill in your own key. .env is gitignored — never
# commit real credentials.
#
# Required only for `python -m xbrlbench run` (sending questions to models
# via OpenRouter: https://openrouter.ai/keys). Not needed for `generate`,
# `grade`, or any offline command.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
